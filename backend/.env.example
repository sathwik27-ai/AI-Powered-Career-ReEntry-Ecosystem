# ==============================================================================
# ReStartHer Backend Environment Template
# Duplicate this file as .env (or configure variables directly in Render Dashboard)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL / Cloud or Local SQLite fallback)
# ------------------------------------------------------------------------------
# For Neon Serverless PostgreSQL (Recommended in Production):
# Copy your pooled or direct connection string from https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# If left unset or set to a placeholder, the backend safely falls back to local SQLite:
# DATABASE_URL=sqlite:///backend/storage/restarther.db

# ------------------------------------------------------------------------------
# 2. JWT SECURITY & ENVIRONMENT
# ------------------------------------------------------------------------------
# In production on Render, set a strong random secret (e.g. generated via `openssl rand -hex 32`):
SECRET_KEY=generate-a-strong-random-hex-secret-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 3. INITIAL PLATFORM ADMINISTRATOR PROVISIONING
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@restarther.org
ADMIN_PASSWORD=SetAStrongAdminPasswordHere!

# ------------------------------------------------------------------------------
# 4. DEMO MODE TOGGLE
# ------------------------------------------------------------------------------
# Set to false in production to prevent seeding demo trainer/learner accounts
DEMO_MODE=false

# ------------------------------------------------------------------------------
# 5. CORS ORIGINS (Frontend Vercel URL)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. your Vercel URL and local preview)
CORS_ORIGINS=https://ai-powered-career-re-entry-ecosystem.vercel.app,http://localhost:5173,http://127.0.0.1:5173
# Optional regex matching Vercel preview deployments (defaults to ^https://.*\.vercel\.app$)
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# ------------------------------------------------------------------------------
# 6. OPTIONAL ANTHROPIC LLM INTEGRATION
# ------------------------------------------------------------------------------
# AI_MODE: "auto" (default, uses Claude if key present), "demo" (deterministic offline), or "llm"
AI_MODE=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ------------------------------------------------------------------------------
# 7. FILE STORAGE LIMITS
# ------------------------------------------------------------------------------
MAX_UPLOAD_MB=5

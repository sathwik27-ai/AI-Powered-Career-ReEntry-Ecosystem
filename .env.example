# =====================================================================
# ReStartHer Platform Configuration (.env)
# =====================================================================

# ---------------------------------------------------------------------
# Database Persistence (Neon PostgreSQL or Local SQLite)
# ---------------------------------------------------------------------
# For cloud deployment with Neon PostgreSQL, uncomment and fill:
# DATABASE_URL=postgresql://neondb_owner:npg_secret@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Default (Zero-Config SQLite):
DATABASE_URL=

# ---------------------------------------------------------------------
# JWT Authentication & Security
# ---------------------------------------------------------------------
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ---------------------------------------------------------------------
# Platform Administration Seed Credentials
# ---------------------------------------------------------------------


# Seeded Demo Accounts (enabled when DEMO_MODE=true)
# Admin:   admin@restarther.org   / AdminSecure123!
# Trainer: trainer@restarther.org / TrainerSecure123!
# Learner: priya@restarther.org   / PriyaSecure123!
DEMO_MODE=true

# ---------------------------------------------------------------------
# AI Agents & LLM Provider Configuration
# ---------------------------------------------------------------------
# AI_MODE: "auto" (uses LLM if key present, else deterministic demo mode)
#          "demo" (always use deterministic offline mode for judging)
#          "llm"  (force LLM extraction and generation)
AI_MODE=auto

# Optional Anthropic / Groq / Gemini API Keys for dynamic generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---------------------------------------------------------------------
# Jotform AI Agent IDs (Verified Production Agents)
# ---------------------------------------------------------------------
# 1. Profile Intake:         01a1de98............................
# 2. Skill Gap Explainer:    01a1de98............................
# 3. Tutor Coach:            01a1de98............................
# 4. Interview Coach:        01a1de98............................
# 5. Job Scout:              01a1de98............................
# 6. Application Assistant:  01a1dea7............................

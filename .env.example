# ==============================================================================
# ReStartHer Root Environment Template
# ==============================================================================

# Backend (FastAPI on Render)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=generate-a-strong-random-hex-secret-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=production
ADMIN_EMAIL=admin@restarther.org
ADMIN_PASSWORD=SetAStrongAdminPasswordHere!
DEMO_MODE=false
CORS_ORIGINS=https://ai-powered-career-re-entry-ecosystem.vercel.app,http://localhost:5173
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
AI_MODE=auto
ANTHROPIC_API_KEY=
MAX_UPLOAD_MB=5

# Frontend (React 18 on Vercel)
# Set VITE_API_BASE_URL to your Render web service URL (without /api suffix)
VITE_API_BASE_URL=https://your-backend-name.onrender.com
